# ─── CMS Payload ────────────────────────────────────────────────────────────
# Clé secrète de chiffrement des sessions/API (obligatoire, longue et aléatoire).
PAYLOAD_SECRET=

# Base de données.
# En local : DATABASE_URI=file:./cms.db (rien d'autre à faire)
# En production (Turso — https://turso.tech, gratuit) :
#   DATABASE_URI=libsql://<nom-base>-<organisation>.turso.io
#   DATABASE_AUTH_TOKEN=<jeton d'accès Turso>
DATABASE_URI=file:./cms.db
DATABASE_AUTH_TOKEN=

# Stockage des images en production (Vercel Blob).
# Créez un store Blob dans le tableau de bord Vercel → Storage → Blob,
# la variable est ajoutée automatiquement au projet.
BLOB_READ_WRITE_TOKEN=

# Adresse publique du site (aperçu en direct, liens absolus).
NEXT_PUBLIC_SERVER_URL=https://www.hallb.fr

# ─── Services existants (déjà configurés sur Vercel) ───────────────────────
# Formulaire de contact (nodemailer + hCaptcha) et avis Google.
# Voir src/app/api/contact/route.ts et src/app/api/google-reviews/route.ts.
